#include "resource.h"
#include "../common/product.h"
#include <windows.h>
#include <commctrl.h>

// Elevation + common controls v6 + OS compatibility.
1 RT_MANIFEST "app.manifest"

// Shown while waiting for the key. Generated by tools/make_tile.py.
IDB_KEY BITMAP "key.bmp"

// Application icon. Must carry the lowest icon id in the file: that is the one
// Explorer and the shell use for the executable. Generated by
// tools/make_icon.py.
IDI_APP ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PRODUCT_VERSION_N
PRODUCTVERSION PRODUCT_VERSION_N
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PRODUCT_PUBLISHER
            VALUE "FileDescription",  PRODUCT_NAME " — регистрация ключа"
            VALUE "FileVersion",      PRODUCT_VERSION
            VALUE "InternalName",     "fido2gui"
            VALUE "LegalCopyright",   PRODUCT_COPYRIGHT
            VALUE "OriginalFilename", "fido2gui.exe"
            VALUE "ProductName",      PRODUCT_NAME
            VALUE "ProductVersion",   PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Main window: what is plugged in, what is enrolled, and what you can do.
IDD_MAIN DIALOGEX 0, 0, 420, 272
STYLE DS_SETFONT | DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION PRODUCT_NAME
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Подключённые ключи:", -1, 10, 8, 400, 10
    CONTROL         "", IDC_KEYLIST, WC_LISTVIEW,
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER |
                    WS_TABSTOP, 10, 20, 400, 76
    LTEXT           "Учётные записи с зарегистрированным ключом:", -1, 10, 102, 400, 10
    CONTROL         "", IDC_LIST, WC_LISTVIEW,
                    LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER |
                    WS_TABSTOP, 10, 114, 400, 92
    PUSHBUTTON      "Зарегистрировать…", IDC_ENROLL, 10, 214, 90, 16
    PUSHBUTTON      "Проверить…", IDC_TEST, 106, 214, 66, 16
    PUSHBUTTON      "Удалить", IDC_REMOVE, 178, 214, 56, 16
    PUSHBUTTON      "Обновить", IDC_REFRESH, 354, 214, 56, 16
    LTEXT           "", IDC_STATUS, 10, 238, 400, 24
END

// Enrollment: account, key, mode, PIN, password. What happens at the key
// itself is explained by the confirmation window, not here.
IDD_ENROLL DIALOGEX 0, 0, 290, 196
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Регистрация ключа"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Учётная запись:", -1, 10, 12, 70, 10
    COMBOBOX        IDC_ACCOUNT, 86, 10, 194, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Ключ:", -1, 10, 32, 70, 10
    COMBOBOX        IDC_DEVICE, 86, 30, 194, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_DEVINFO, 86, 46, 194, 9
    AUTOCHECKBOX    "Режим U2F — слабее, см. README", IDC_U2F,
                    10, 58, 270, 10, WS_TABSTOP
    LTEXT           "PIN ключа:", -1, 10, 76, 70, 10
    EDITTEXT        IDC_EPIN, 86, 74, 194, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Пароль Windows:", -1, 10, 96, 70, 10
    EDITTEXT        IDC_PW1, 86, 94, 194, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "Повторите пароль:", -1, 10, 116, 74, 10
    EDITTEXT        IDC_PW2, 86, 114, 194, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_HINT, 10, 134, 270, 18
    LTEXT           "", IDC_ESTATUS, 10, 156, 270, 18
    DEFPUSHBUTTON   "Зарегистрировать", IDOK, 150, 174, 76, 16
    PUSHBUTTON      "Отмена", IDCANCEL, 232, 174, 48, 16
END

// Shared prompt for operations that only need the key and its PIN.
IDD_KEY DIALOGEX 0, 0, 290, 130
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Проверка ключа"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "", IDC_KPROMPT, 10, 10, 270, 20
    LTEXT           "Ключ:", -1, 10, 36, 70, 10
    COMBOBOX        IDC_KDEVICE, 86, 34, 194, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "PIN ключа:", -1, 10, 56, 70, 10
    EDITTEXT        IDC_KPIN, 86, 54, 194, 13, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_ESTATUS, 10, 76, 270, 26
    DEFPUSHBUTTON   "Проверить", IDOK, 162, 106, 64, 16
    PUSHBUTTON      "Отмена", IDCANCEL, 232, 106, 48, 16
END

// The window that actually drives the key: says what to do with it, waits for
// it to be plugged in, and reports each step.
IDD_CONFIRM DIALOGEX 0, 0, 300, 212
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Подтверждение на ключе"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    CONTROL         "", IDC_KEYPIC, "Static", SS_BITMAP | SS_CENTERIMAGE |
                    WS_CHILD | WS_VISIBLE, 16, 20, 50, 44
    LTEXT           "", IDC_CTITLE, 92, 18, 196, 12
    LTEXT           "", IDC_CTEXT, 92, 34, 196, 100
    LTEXT           "", IDC_CSTATUS, 16, 140, 272, 26
    PUSHBUTTON      "Использовать вставленный ключ", IDC_USEPRESENT,
                    16, 178, 146, 16
    PUSHBUTTON      "Отмена", IDCANCEL, 240, 178, 48, 16
END
