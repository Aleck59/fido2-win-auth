#include <windows.h>
#include "../common/product.h"

// Same icon as the window, so the console tool is recognisable in Explorer.
100 ICON "../gui/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PRODUCT_VERSION_N
PRODUCTVERSION PRODUCT_VERSION_N
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      PRODUCT_PUBLISHER
            VALUE "FileDescription",  PRODUCT_NAME " — консольная регистрация"
            VALUE "FileVersion",      PRODUCT_VERSION
            VALUE "InternalName",     "enroll"
            VALUE "LegalCopyright",   PRODUCT_COPYRIGHT
            VALUE "OriginalFilename", "enroll.exe"
            VALUE "ProductName",      PRODUCT_NAME
            VALUE "ProductVersion",   PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
